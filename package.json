{
  "name": "@openassistant/kepler-assistant",
  "version": "0.0.15",
  "description": "The kepler.gl AI assistant: the analysis engines (data.*, geoda.*, geo.*, chart.*) + agent loop + the kepler-agnostic ChatToolSurface. Consumes the @kepler.gl/mcp map surface (map.* commands, contract, kepler skill) from the kepler.gl monorepo.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/analysis-commands.d.ts",
      "import": "./dist/analysis-commands.js"
    },
    "./tool-surface": {
      "types": "./dist/tool-surface.d.ts",
      "import": "./dist/tool-surface.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "import": "./dist/chat/index.js"
    }
  },
  "scripts": {
    "generate-skills": "node scripts/generate-skills.mjs",
    "build": "node scripts/generate-skills.mjs && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.2",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.18",
    "@geoda/core": "^0.0.25",
    "@geoda/lisa": "^0.0.25",
    "@geoda/regression": "^0.0.25",
    "@kepler.gl/actions": "3.3.0-alpha.8",
    "@kepler.gl/components": "3.3.0-alpha.8",
    "@kepler.gl/constants": "3.3.0-alpha.8",
    "@kepler.gl/layers": "3.3.0-alpha.8",
    "@kepler.gl/mcp": "file:/Users/xun/Downloads/kepler.gl/src/mcp",
    "@kepler.gl/processors": "3.3.0-alpha.8",
    "@kepler.gl/reducers": "3.3.0-alpha.8",
    "@kepler.gl/table": "3.3.0-alpha.8",
    "@kepler.gl/types": "3.3.0-alpha.8",
    "@sqlrooms/ai": "0.29.0-rc.12",
    "@sqlrooms/ai-core": "0.29.0-rc.12",
    "@sqlrooms/duckdb": "0.29.0-rc.12",
    "@sqlrooms/room-store": "0.29.0-rc.12",
    "@sqlrooms/ui": "0.29.0-rc.12",
    "@turf/bbox": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/rectangle-grid": "^7.4.0",
    "ai": "^7.0.31",
    "apache-arrow": "^17.0.0",
    "color-interpolate": "^1.0.5",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "lucide-react": "^1.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redux": "^5.0.0",
    "redux-actions": "^2.2.1",
    "zip3": "^1.0.4",
    "zod": "^4.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@danmarshall/deckgl-typings"
    ]
  }
}
